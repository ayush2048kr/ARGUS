
# ==========================================
# ARGUS - Git Ignore Rules
# ==========================================

# ------------------------------------------
# Data files
# ------------------------------------------

# Raw and processed datasets
data/raw/
data/processed/

# CSV datasets and generated data
*.csv

# Archives and compressed files
*.zip
*.rar
*.7z
*.tar
*.gz

# ------------------------------------------
# Python
# ------------------------------------------

__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
venv311/
.venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/

# ------------------------------------------
# Environment variables and secrets
# ------------------------------------------

.env
.env.*
!.env.example

backend/.env
frontend/.env

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx

# ------------------------------------------
# Frontend
# ------------------------------------------

node_modules/
frontend/node_modules/

frontend/dist/
frontend/build/

npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ------------------------------------------
# Backend and application logs
# ------------------------------------------

*.log
logs/

# ------------------------------------------
# Temporary files
# ------------------------------------------

tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ------------------------------------------
# Jupyter
# ------------------------------------------

.ipynb_checkpoints/

# ------------------------------------------
# MongoDB
# ------------------------------------------

mongodb/
mongodata/

# ------------------------------------------
# IDE and editor files
# ------------------------------------------

.vscode/
.idea/
*.iml

# ------------------------------------------
# Operating system files
# ------------------------------------------

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# ------------------------------------------
# Generated ARGUS risk-pipeline outputs
# ------------------------------------------

ml/evaluation/output/argus_risk_pipeline_daily.csv
ml/evaluation/output/argus_risk_pipeline_summary.csv
ml/evaluation/output/peer_deviation_user_profiles.csv
